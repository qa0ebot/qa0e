// ================= GAME STATES =================
const games = new Map();

// ================= RANKS mit IDs =================
const ranks = [
  { name: "Trainee Mod", id: "1516136080070545539" },
  { name: "Server Mod", id: "1514617279411650733" },
  { name: "Head of Mod", id: "1519406555173490698" },
  { name: "Admin", id: "1518174071786045521" },
  { name: "Head Admin", id: "1519407237976817827" },
  { name: "Server Manager", id: "1519407618458910831" },
  { name: "Co-Owner", id: "1514609103723430009" }
];

const staffRoleId = "1514614203024146484"; // Server Staff

// ================= ROLE HELPER =================
function getRole(guild, identifier) {
  if (!identifier) return null;
  let role = guild.roles.cache.get(identifier);
  if (role) return role;
  return guild.roles.cache.find(r => r.name.toLowerCase() === identifier.toLowerCase());
}

// ================= LOG =================
function log(guild, text) {
  const channel = guild.channels.cache.find(c => c.name === config.modlogChannel);
  if (!channel) return;

  const embed = new EmbedBuilder()
    .setColor("Red")
    .setDescription(`📌 ${text}`)
    .setFooter({ text: "made by qa0e" })
    .setTimestamp();

  channel.send({ embeds: [embed] });
}

